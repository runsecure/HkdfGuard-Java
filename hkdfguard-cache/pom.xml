<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.runsecure.hkdfguard</groupId>
    <artifactId>hkdfguard-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>hkdfguard-cache</artifactId>
  <packaging>jar</packaging>

  <name>HkdfGuard Cache</name>
  <description>Default ProtectedCache (a single, already-built DataEncryptionKey backing a highly concurrent encrypted-value cache) and ProtectedCacheCollectionImpl, an ordered aggregate of read-only cache sources.</description>

  <dependencies>
    <dependency>
      <groupId>com.runsecure.hkdfguard</groupId>
      <artifactId>hkdfguard-abstractions</artifactId>
    </dependency>
    <dependency>
      <groupId>com.runsecure.hkdfguard</groupId>
      <artifactId>hkdfguard-diagnostics</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <!-- Test-only: real DataEncryptionKey plumbing to exercise the cache against a real cipher,
         matching the C# test project's own dependencies. -->
    <dependency>
      <groupId>com.runsecure.hkdfguard</groupId>
      <artifactId>hkdfguard-cryptosession-aesgcm256</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.runsecure.hkdfguard</groupId>
      <artifactId>hkdfguard-dataencryptionkey</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk-testing</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
